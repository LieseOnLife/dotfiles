[user]
	name = Saje Liese
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIO2Zhda8Ap95SqktOST2QhOUG1nkN5uWuIe/2+E7k753

# Local config (not tracked) - contains email
[include]
	path = ~/.gitconfig.local

# Signing config (key must be global for dd-gitsign to work)
[gpg]
	format = ssh
[gpg "ssh"]
	program = dd-gitsign
[commit]
	gpgsign = false
[tag]
	gpgsign = false

# Datadog repo config (enables signing) - loaded conditionally
[includeIf "gitdir:~/dd/"]
	path = ~/.gitconfig-datadog
[includeIf "gitdir:~/go/src/github.com/DataDog/"]
	path = ~/.gitconfig-datadog
[url "git@github.com:"]
	insteadOf = https://github.com/
[core]
	excludesfile = ~/.gitignore_global
	# hooksPath = /path/to/your/hooks  # Optional: Add if you use global git hooks
[pull] 
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# [safe]
	# directory = /path/to/safe/repo  # Optional: Add safe directories if needed

# [include]
	# path = ~/.config/gitsign/gitconfig  # Optional: Include additional git config

# [maintenance]
	# repo = /path/to/repo  # Optional: Add repos for git maintenance
[credential]
	helper = store
[checkout]
	guess = false
[fetch]
	prune = true
