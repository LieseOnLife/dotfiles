###################
### Tool Integrations
###################

# iTerm2 shell integration
[[ -e "${HOME}/.iterm2_shell_integration.zsh" ]] && source "${HOME}/.iterm2_shell_integration.zsh"

# Git Machette auto-complete
source <(git machete completion zsh)

# fzf autocomplete
[ -f /opt/homebrew/opt/fzf/shell/completion.zsh ] && source /opt/homebrew/opt/fzf/shell/completion.zsh
[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh

# fzf-tab (replaces zsh completion menu with fzf)
if [ ! -d ~/repos/fzf-tab ]; then
    git -C ~/repos clone https://github.com/Aloxaf/fzf-tab
fi
if [ -f ~/repos/fzf-tab/fzf-tab.plugin.zsh ]; then
    source ~/repos/fzf-tab/fzf-tab.plugin.zsh
fi

# Google Cloud SDK
if [ -f '~/google-cloud-sdk/path.zsh.inc' ]; then
    source '~/google-cloud-sdk/path.zsh.inc'
fi

if [ -f '~/google-cloud-sdk/completion.zsh.inc' ]; then
    source '~/google-cloud-sdk/completion.zsh.inc'
fi

# pyenv initialization
if command -v pyenv 1>/dev/null 2>&1; then
    eval "$(pyenv init -)"
    eval "$(pyenv init --path)"
fi

# rbenv initialization
if command -v rbenv 1>/dev/null 2>&1; then
    eval "$(rbenv init -)"
fi

# AWS completion
if command -v aws_completer 1>/dev/null 2>&1; then
    autoload bashcompinit && bashcompinit
    complete -C aws_completer aws
fi

# kubectl completion
if command -v kubectl 1>/dev/null 2>&1; then
    source <(kubectl completion zsh)
    # Make 'k' alias work with completion
    compdef k=kubectl
fi

# dd-gitsign
if command -v dd-gitsign &> /dev/null; then
    eval "$(dd-gitsign load-key)"
fi

# direnv hook
if command -v direnv 1>/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

# zoxide initialization
if command -v zoxide 1>/dev/null 2>&1; then
    export _ZO_DOCTOR=0
    eval "$(zoxide init zsh)"
fi

# SCFW environment variables
export SCFW_DD_AGENT_LOG_PORT="10365"
export SCFW_DD_LOG_LEVEL="ALLOW"
export SCFW_HOME="~/.scfw"

# Git worktree completion (gws, gwr)
_git_worktree_paths() {
  local worktrees=("${(@f)$(git worktree list 2>/dev/null | awk '{print $1}')}")
  compadd -a worktrees
}
compdef _git_worktree_paths gws
compdef _git_worktree_paths gwr

# Obsidian
export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"
