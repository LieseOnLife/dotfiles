alias zsp="vi ~/repos/dotfiles/.p10k.zsh"          # Edit powerlevel10k config
alias zssh="vi ~/repos/dotfiles/.ssh/config"       # Edit SSH config
alias zsd="vi ~/.zshrc_datadog"     # Edit Datadog config

# Reload config
alias szs="source ~/.zshrc"         # Source/reload zsh config

# Rose stuff
alias sshr="ssh saje@192.168.50.10"

# SCFW aliases
alias npm="scfw run npm"
alias pip="scfw run pip"
alias poetry="scfw run poetry"
