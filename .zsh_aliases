###################
### Git Shortcuts
###################

alias gitssh1="ssh -T git@github.com"
alias g="git"
alias gb="git branch"
alias gbd="gb -D"
alias gss="git status"
alias gs="git switch"
alias gsf="git switch -f"
alias gst="git stash"
alias gsta="gst apply"
alias gstd="gst drop"
alias gp="git pull"
alias gpu="git push"
alias gpo="gp origin"
alias gpuo="gpu origin"
alias gpoh="gpuo HEAD"
alias gpop="gpo prod"
alias gr="git rebase"
alias grc="gr --continue"
alias gro="gr --onto"

# Smart aliases that auto-detect main/master
alias gsm="gsm_auto"      # Switch to default branch and pull
alias gpom="gpom_auto"    # Pull from default branch
alias grm="grm_auto"      # Rebase on default branch
alias gu="gu_auto"        # Update: switch to default, back, rebase
alias gus="gus_auto"      # Update with stash
alias ga="git add"
alias gaa="ga -A && gss"
alias gast="gaa && gst"
alias gt="git tag"
alias gtp="git push --tags"
alias gc="git commit"
alias gca="gc --amend"
alias gcpoh="gc && gpoh"
alias gac="gaa && gc"
alias gacpoh="gaa && gc && gpoh"
alias gacrc="gac && grc"
alias gf="git fetch"
alias gclean='git branch --merged $(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed "s@^refs/remotes/origin/@@") | \grep -Ev "main|master|\*" | xargs -r git branch -d'

###################
### Git Machete
###################

alias gm="git machete"
alias gms="gm status"                # Show branch tree with sync status
alias gmsl="gm status -l"            # Show branch tree with commits
alias gmt="gm traverse"              # Walk through and update all branches
alias gmty="gm traverse -y"          # Traverse without confirmations
alias gmtw="gm traverse -W"          # Traverse, push to remote
alias gmu="gm update"                # Rebase current branch on parent
alias gmum="gm update -m"            # Merge current branch with parent (no rebase)
alias gmgo="gm go"                   # Interactive branch selection
alias gmgu="gm go up"                # Go to parent branch
alias gmgd="gm go down"              # Go to first child branch
alias gmgr="gm go root"              # Go to root branch
alias gmgn="gm go next"              # Go to next sibling branch
alias gme="gm edit"                  # Edit branch layout file
alias gma="gm add"                   # Add current branch to tree
alias gmao="gm add -o"               # Add branch as child of current
alias gmd="gm discover"              # Auto-discover branch dependencies
alias gmdy="gm discover -y"          # Auto-discover without confirmation
alias gmso="gm slide-out"            # Slide out current branch (after merge)
alias gmsod="gm slide-out -d"        # Slide out and delete branch
alias gmdf="gm diff"                 # Diff against fork point
alias gml="gm log"                   # Log branch-specific commits
alias gmsq="gm squash"               # Squash branch commits into one
alias gmadv="gm advance"             # Fast-forward to child, push, slide out
alias gmgh="gm github"               # GitHub PR integration
alias gmghc="gm github create"       # Create PR for current branch
alias gmghco="gm github checkout"    # Checkout PR by number

###################
### Git Worktree
###################

# Binary paths (change these if tools move)
GIT_BIN="/opt/homebrew/bin/git"
CODE_BIN="/usr/local/bin/code"

alias gw="git worktree"                 # Base command

# Creating worktrees
# gwa: Add worktree, auto-creates saje/<folder-name> branch
unalias gwa 2>/dev/null
gwa() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: gwa <path> [commit-ish]"
    echo "Creates: git worktree add -b saje/<folder-name> <path>"
    return 1
  fi
  local path="$1"
  local branch_name="saje/${path:t}"
  shift
  $GIT_BIN worktree add -b "$branch_name" "$path" "$@"
}

# gwaa: Add worktree and switch to it
gwaa() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: gwaa <path> [commit-ish]"
    echo "Creates worktree and switches to it"
    return 1
  fi
  local path="$1"
  gwa "$@" && builtin cd "$path"
}
alias gwab="git worktree add -b"        # Add worktree with explicit branch name
alias gwad="git worktree add --detach"  # Add worktree in detached HEAD

# Managing worktrees
alias gwl="$GIT_BIN worktree list"           # List all worktrees

# gwr: Remove a worktree (uses fzf for selection)
unalias gwr 2>/dev/null
gwr() {
  local worktree worktrees
  if [[ $# -ge 1 ]]; then
    $GIT_BIN worktree remove "$@"
    return
  fi

  # Check if we're in a git repo
  if ! $GIT_BIN rev-parse --git-dir &>/dev/null; then
    echo "Not in a git repository"
    return 1
  fi

  # Get worktree list
  worktrees=$($GIT_BIN worktree list 2>/dev/null)
  if [[ -z "$worktrees" ]]; then
    echo "No worktrees found"
    return 1
  fi

  # Use fzf to select
  worktree=$(echo "$worktrees" | fzf --height 40% --reverse | awk '{print $1}')
  if [[ -n "$worktree" ]]; then
    $GIT_BIN worktree remove "$worktree"
  fi
}

# gwrf: Force remove a worktree (uses fzf for selection)
unalias gwrf 2>/dev/null
gwrf() {
  local worktree worktrees
  if [[ $# -ge 1 ]]; then
    $GIT_BIN worktree remove --force "$@"
    return
  fi

  # Check if we're in a git repo
  if ! $GIT_BIN rev-parse --git-dir &>/dev/null; then
    echo "Not in a git repository"
    return 1
  fi

  # Get worktree list
  worktrees=$($GIT_BIN worktree list 2>/dev/null)
  if [[ -z "$worktrees" ]]; then
    echo "No worktrees found"
    return 1
  fi

  # Use fzf to select
  worktree=$(echo "$worktrees" | fzf --height 40% --reverse | awk '{print $1}')
  if [[ -n "$worktree" ]]; then
    $GIT_BIN worktree remove --force "$worktree"
  fi
}
alias gwm="git worktree move"           # Move worktree to new path

# Maintenance
alias gwp="git worktree prune"          # Clean stale worktree info
alias gwpd="git worktree prune --dry-run" # Preview what would be pruned
alias gwlk="git worktree lock"          # Prevent worktree removal
alias gwulk="git worktree unlock"       # Allow worktree removal
alias gwR="git worktree repair"         # Fix broken worktree links
alias gwu="gwu_auto"                    # Update branch: fetch and rebase (no switch)

# gws: Switch to a worktree directory (uses fzf for selection)
gws() {
  local worktree worktrees
  if [[ $# -ge 1 ]]; then
    builtin cd "$1"
    return
  fi

  # Check if we're in a git repo
  if ! $GIT_BIN rev-parse --git-dir &>/dev/null; then
    echo "Not in a git repository"
    return 1
  fi

  # Get worktree list
  worktrees=$($GIT_BIN worktree list 2>/dev/null)
  if [[ -z "$worktrees" ]]; then
    echo "No worktrees found"
    return 1
  fi

  # Use fzf to select
  worktree=$(echo "$worktrees" | fzf --height 40% --reverse | awk '{print $1}')
  if [[ -n "$worktree" ]]; then
    builtin cd "$worktree"
  fi
}

# gwc: Open a worktree in VS Code (uses fzf for selection)
gwc() {
  local worktree worktrees
  if [[ $# -ge 1 ]]; then
    $CODE_BIN "$1"
    return
  fi

  # Check if we're in a git repo
  if ! $GIT_BIN rev-parse --git-dir &>/dev/null; then
    echo "Not in a git repository"
    return 1
  fi

  # Get worktree list
  worktrees=$($GIT_BIN worktree list 2>/dev/null)
  if [[ -z "$worktrees" ]]; then
    echo "No worktrees found"
    return 1
  fi

  # Use fzf to select
  worktree=$(echo "$worktrees" | fzf --height 40% --reverse | awk '{print $1}')
  if [[ -n "$worktree" ]]; then
    $CODE_BIN "$worktree"
  fi
}

