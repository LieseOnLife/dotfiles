alias zsa="vi ~/repos/dotfiles/.zsh_aliases"       # Edit aliases
alias zsf="vi ~/repos/dotfiles/.zsh_functions"     # Edit functions
alias zsi="vi ~/repos/dotfiles/.zsh_integrations"  # Edit integrations
