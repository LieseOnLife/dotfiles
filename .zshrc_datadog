## devops hotfix
export DEVOPS_WORKDIR="~/devenv/devops"

function devopstime() {
    cd $DEVOPS_WORKDIR
    git checkout prod
    git pull
    HOTFIXLINK="https://github.com/DataDog/devops/compare/$(git describe --abbrev=0 --tags)...prod"
    echo -n $HOTFIXLINK | pbcopy
    echo "$HOTFIXLINK copied to clipboard"
    open $HOTFIXLINK
    cd -
}

