# ~/.zshrc_datadog - Datadog-specific aliases and functions (tracked in dotfiles).

# Datadog laptop-ansible block (homebrew, pyenv, GOPATH, DATADOG_ROOT, GOPROXY, ...).
# Machine-local and untracked; enter ~/.zshrc_datadog_ansible at the laptop-ansible
# "path to your shell config file" prompt so re-runs update that file, not this one.
[[ -s ~/.zshrc_datadog_ansible ]] && source ~/.zshrc_datadog_ansible
export DATADOG_ROOT="${DATADOG_ROOT:-$HOME/dd}"

# Machine-local values, untracked because this repo is public: AppGate URLs, emails
# (DD_EMAIL, DD_GOV_EMAIL), Azure IDs, and aliases/functions with internal hostnames
# (vault logins, aikey, CNAB/vendify targets, CNAB dev env).
[[ -s ~/.zshrc_datadog_local ]] && source ~/.zshrc_datadog_local

#### Datadog ####

## Packs (JIT) ##
alias dd="ddtool"
alias ddcj="dd cloud jit"
alias ddcja='ddcj --pack aws-org-account-admins --add "$DD_EMAIL" --ttl 8h'
alias ddcjg='ddcj --pack gcp-org-account-admins --add "$DD_EMAIL" --ttl 8h'
alias pgaa="ddcjg && cal & caal"

## cavmctl
export PATH=$PATH:$HOME/.local/bin/cavmctl

## gcloud SDK
[ -f "$HOMEBREW_PREFIX/share/google-cloud-sdk/path.zsh.inc" ] && source "$HOMEBREW_PREFIX/share/google-cloud-sdk/path.zsh.inc"
[ -f "$HOMEBREW_PREFIX/share/google-cloud-sdk/completion.zsh.inc" ] && source "$HOMEBREW_PREFIX/share/google-cloud-sdk/completion.zsh.inc"

## GitLab (only set GITLAB_TOKEN if it exists in keychain)
if _gitlab_token=$(security find-generic-password -a "$USER" -s gitlab_token -w 2>/dev/null); then
    export GITLAB_TOKEN="$_gitlab_token"
fi
unset _gitlab_token
alias gitlab='export GITLAB_TOKEN=$(security find-generic-password -a ${USER} -s gitlab_token -w)'
alias gitlabl='ddtool auth gitlab login'

