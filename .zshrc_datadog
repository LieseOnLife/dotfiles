# ~/.zshrc_datadog - Datadog-specific aliases and functions (tracked in dotfiles).

# Datadog laptop-ansible block (homebrew, pyenv, GOPATH, DATADOG_ROOT, GOPROXY, ...).
# Machine-local and untracked; enter ~/.zshrc_datadog_ansible at the laptop-ansible
# "path to your shell config file" prompt so re-runs update that file, not this one.
[[ -s ~/.zshrc_datadog_ansible ]] && source ~/.zshrc_datadog_ansible

# Machine-local secrets/values (AppGate profile URLs, ...). Untracked: this repo is public.
[[ -s ~/.zshrc_datadog_local ]] && source ~/.zshrc_datadog_local

