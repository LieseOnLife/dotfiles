awsconfigu() {
    brew update && brew upgrade ddtool
    cp ~/.aws/config ~/.aws/config.backup.backup$(date +"%m-%d-%Y")
    cd $DATADOG_ROOT/devtools && git pull && cd -
    $DATADOG_ROOT/devtools/bin/setup-awsconfig $(whoami) > ~/.aws/config
}

