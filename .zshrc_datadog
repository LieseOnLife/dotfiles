## devops hotfix
export DEVOPS_WORKDIR="$HOME/devenv/devops"

function devopstime() {
    cd "$DEVOPS_WORKDIR" || return
    git checkout prod
    git pull
    HOTFIXLINK="https://github.com/DataDog/devops/compare/$(git describe --abbrev=0 --tags)...prod"
    echo -n $HOTFIXLINK | pbcopy
    echo "$HOTFIXLINK copied to clipboard"
    open $HOTFIXLINK
    cd -
}

## CNAB dev env (`de` endpoints live in ~/.zshrc_datadog_local)
alias mde="make devenv"
alias mded="make devenv-destroy"
alias cnmde="cdcn && mde"

devenv-logs() {
    local devenv_pod_name=$(kubectl get po --all-namespaces | ruby -e 'puts gets("")[/cnab-api-dev-saje-liese\S*/]')
    echo "Finding logs for $devenv_pod_name..."
    kubectl logs $devenv_pod_name --namespace=delivery-platform --container=main
}
